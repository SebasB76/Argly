# Copiar a .env y completar. NO subir el .env real al repositorio.

# === LLM / Agente de IA ===
# Opciones: OpenAI-compatible (DeepSeek por defecto), Anthropic o Gemini (Google)
# Para OpenAI/DeepSeek:
# LLM_API_KEY=tu_llave_openai_compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_PROVIDER=openai

# Para Gemini (Google Generative API) con API Key simple:
# GEMINI_API_KEY=tu_llave_gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

ANTHROPIC_API_KEY=tu_llave_aqui
# OPENAI_API_KEY=tu_llave_aqui

# === Enriquecimiento externo ===
GOOGLE_MAPS_API_KEY=tu_llave_aqui
WEATHER_API_KEY=tu_llave_aqui

# === Canales de notificación ===
WHATSAPP_API_TOKEN=tu_token_aqui
WHATSAPP_PHONE_ID=tu_id_aqui
EMAIL_SMTP_HOST=smtp.ejemplo.com
EMAIL_SMTP_USER=usuario
EMAIL_SMTP_PASSWORD=tu_password_aqui

# === Base de datos ===
# Local: si se omite, usa SQLite en data/argly.db. En producción, Postgres gestionado
# (Neon/Supabase/Render). Para SQLAlchemy 2 + psycopg2 usa el prefijo +psycopg2:
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/argly

# === Despliegue (backend) ===
# Origen(es) del frontend permitidos por CORS (separados por coma). Por defecto "*".
# En producción, ponlo a la URL de Vercel, p. ej.:
# CORS_ORIGINS=https://argly.vercel.app
CORS_ORIGINS=*
