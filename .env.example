# Copiar a .env y completar. NO subir el .env real al repositorio.

# === LLM / Agente de IA ===
ANTHROPIC_API_KEY=tu_llave_aqui
# OPENAI_API_KEY=tu_llave_aqui

# === Enriquecimiento externo ===
GOOGLE_MAPS_API_KEY=tu_llave_aqui
WEATHER_API_KEY=tu_llave_aqui

# === Canales de notificación ===
WHATSAPP_API_TOKEN=tu_token_aqui
WHATSAPP_PHONE_ID=tu_id_aqui
EMAIL_SMTP_HOST=smtp.ejemplo.com
EMAIL_SMTP_USER=usuario
EMAIL_SMTP_PASSWORD=tu_password_aqui

# === Base de datos ===
DATABASE_URL=postgresql://usuario:password@localhost:5432/argly
